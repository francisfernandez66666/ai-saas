# ============================================
# 车企AI-SCRM系统 环境变量配置文件
# 使用方法：复制为 .env 文件，然后修改对应配置
# ============================================

# ---- 服务配置 ----
SERVER_PORT=9090
# 2026-09-22 复核 P2-11：示例默认改为 release。
# debug 不是"日志更详细"这么简单——它会打开一批仅开发态才允许的能力
# （如 X-Tenant-ID 头被直接采信、mock-pay 模拟到账放行），示例即生产模板，
# 拿去部署等于默认把后门开着。本地开发请在自己的 .env 里改回 debug。
GIN_MODE=release
# 日志格式（2026-09-15 增强批）：json=结构化单行（云端聚合检索）/ text=人类可读
# 留空 = release 默认 json、debug 默认 text；全仓 log.Printf 经 slog 桥接，无需改调用点
LOG_FORMAT=
# CORS 跨域白名单（P0安全止血 2026-08-26）：逗号分隔的允许 Origin 列表（含协议、不带尾部斜杠）
# 留空 = 同源模式（不回 CORS 头）；APK 内嵌壳等跨端场景把壳的 Origin 加进来，如：
# CORS_ALLOWED_ORIGINS=https://www.example.com,https://capacitor.localhost
# 键名已统一为 CORS_ALLOWED_ORIGINS（P1-3 修复；旧键 CORS_ALLOW_ORIGINS 仍兼容一版本）
CORS_ALLOWED_ORIGINS=

# ---- 数据库配置 (PostgreSQL) ----
# SaaS 化改造：从 SQLite 迁移到 PostgreSQL 多租户数据库
DB_HOST=localhost
DB_PORT=5432
DB_USER=ai_scrm
DB_PASSWORD=dev123
DB_NAME=ai_scrm
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=300

# ---- AI模型配置 ----
# 智谱AI API Key（去 https://open.bigmodel.cn/ 申请，替换为你的真实Key）
ZHIPU_API_KEY=your-zhipu-api-key
# 兼容旧字段（也可以用GLM_API_KEY）
GLM_API_KEY=your-zhipu-api-key
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4.7-flash
# 智谱详细配置
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4.7-flash
ZHIPU_MODEL_BACKUP=glm-4-flash
ZHIPU_MAX_TOKENS=500
ZHIPU_TEMPERATURE=0.7

# 硅基流动 API Key（去 https://cloud.siliconflow.cn/ 申请）
# 用于跨平台降级兜底，9B以下模型永久免费
SILICONFLOW_API_KEY=sk-your-siliconflow-key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=THUDM/GLM-4-9B-0414
SILICONFLOW_MODEL_BACKUP=deepseek-ai/DeepSeek-V4-Flash
# DeepSeek 官网直连（P1-5→批三 第三独立供应商）：硅基流动平台整体故障时的跨供应商第三路；
# 不配 Key 即不装配，降级链维持原状
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 是否模拟模式：true=不调用真实AI（开发调试用）, false=调用真实API
AI_MOCK_MODE=false

# ---- AI 网关（独立出网枢纽，P0-1）----
# 生产部署：单起 ./ai-gateway（或 ./start.sh gateway），业务实例配 LLM_GATEWAY_URL 指向它，
# 出网与计费上收网关（含 fail-closed 配额闸 + 多模型降级），网关挂掉业务自动降级规则话术。
# LLM_GATEWAY_LISTEN 仅网关进程使用；业务实例不配 LLM_GATEWAY_URL 则本地直连厂商。
# LLM_GATEWAY_TOKEN 为网关与本地实例共享密钥（HMAC 签名/验签），两端须一致。
# 安全（P0-5，2026-09-09）：LLM_GATEWAY_LISTEN 默认留空——非空即在本进程内嵌启动网关，
# 且必须同时配 LLM_GATEWAY_TOKEN，否则拒绝启动（防暴露无鉴权 LLM 代理）。
LLM_GATEWAY_URL=
LLM_GATEWAY_TOKEN=change-me-gateway-shared-secret
LLM_GATEWAY_MODEL=
LLM_GATEWAY_LISTEN=

# ---- 向量检索 Embedding（KB 语义检索，P0-4 + pgvector 补充）----
# 配置 EMBEDDING_API_URL 即点亮向量检索；未配置回退纯关键词
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# 向量维度：须与 EMBEDDING_MODEL 输出维度一致（pgvector 列定长）。不匹配会自动裁剪/补零（降级质量）
EMBEDDING_DIM=1536

# ---- KB 检索重排 Rerank（E9，可选）----
# 配置 RERANK_API_URL 即启用重排客户端（OpenAI 兼容 /v1/rerank，如硅基流动）；未配置零行为差
# 生效还需系统配置 kb_rerank=true（默认关）；调用失败/超时一律 fail-open 原序
RERANK_API_URL=
# 留空则复用 EMBEDDING_API_KEY
RERANK_API_KEY=
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ---- JWT配置 ----
# 安全红线：生产环境必须替换为 ≥32 位随机串（如 openssl rand -hex 32），否则 token 可被伪造
JWT_SECRET=change-me-to-a-random-32-char-secret-in-production
JWT_EXPIRE_HOURS=24

# ============================================
# 策略中心超参数Θ（可根据效果调整）
# ============================================

# Step2: softmax温度系数（越小越锐利，越大越平滑）
TAU=0.8

# Step3: 软降级相关
THETA_CONF=0.5
SIM_THRESH=0.55
THETA_HOOKRATE_LOW=0.4
THETA_SILENT=60

# Step6: 路由决策阈值
THETA_TRUST=0.3
THETA_ROUNDS=3
THETA_HOOKRATE_CRIT=0.2

# L3强制切人阈值
THETA_L3_INTENT=0.8
THETA_L3_ROUNDS=2

# 紧迫等级阈值
THETA_URGENCY_L1=0.5
THETA_URGENCY_L2=0.7

# 人工超时接管（秒）
HUMAN_TIMEOUT_SECONDS=180

# ============ Redis (多实例协调层) ============
# 多实例部署必开：消息合并队列互斥锁 / 跨实例消息转交 / 缓存版本戳失效
# 单实例开发可关（false=纯内存模式，行为与单机版一致）
REDIS_ENABLED=false
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ============ 消息中心 (Kafka, SAAS_PLAN §2.5) ============
# log=结构化日志降级（默认，无需 Kafka）；kafka=真实总线
MQ_TYPE=log
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_PREFIX=ai-scrm.

# ============ 商业化：SMTP 邮件通道 (M3 重置码，批次三启用) ============
# 填齐后到后台「触达通知」把 reset_code_channel 切为 smtp 即发邮件（留空自动降级 log 通道）
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ============ Token统一计费 & 数据飞轮 (P1.5/P3) ============
# 行业包密钥（引擎侧：验签公钥+解封私钥；随部署物分发，不入库）
# INDUSTRY_PACK_PRIV_KEY=keys/pack_priv.pem
# INDUSTRY_PACK_PUB_KEY=keys/pack_pub.pem
# 数据飞轮回流 collector（HTTPS；空=关闭。每小时回传脱敏审计增量）
# FEEDBACK_COLLECTOR_URL=https://collector.example.com/api/v1/feedback/ingest
# 说明：token_billing_enabled / billing_enforced / feedback_collector_url 均为后台热配置（💰商业化面板），非 .env 项

# ============ 商业化：异地备份推送 (批次三，可选) ============
# 本地备份+完整性校验通过后自动执行；{{FILE}} 替换为本次备份文件路径；留空=关闭
# BACKUP_REMOTE_CMD=rclone copy {{FILE}} remote:ai-scrm-backups
BACKUP_REMOTE_CMD=

# ============ 备份专用角色（FIX-A 后续，2026-09-28）============
# RLS 通电（迁移 030 给租户表补 ENABLE ROW LEVEL SECURITY）之后，pg_dump/pg_restore 会
# 在会话里 `SET row_security = off`；PG 对"受策略约束的角色请求关 RLS"直接报错，
# 于是**用应用角色跑备份必然在 COPY 那步失败**（迁移 030 之后才暴露，此前策略从不被咨询）。
# 这里填一个能旁路 RLS 的只读角色：生产 docker-compose 用编排的 POSTGRES_USER（超级用户）即可；
# 需要单独口令时再设 BACKUP_DB_PASSWORD，否则沿用 PGPASSWORD。留空=沿用应用角色 PGUSER。
# ⚠ 两种"看起来更省事"的修法都不要采用：
#   ① 给应用角色加 BYPASSRLS —— 应用与该角色同体，等于所有连接无条件旁路，第二道闸白做；
#   ② 对表 NO FORCE / DISABLE ROW LEVEL SECURITY —— 直接把刚通电的策略退回"挂着但不生效"。
# tools/backup.sh 在开跑前会判这两件事并把结论打出来（判不过就 exit 1，不出半截归档）。
BACKUP_DB_USER=
BACKUP_DB_PASSWORD=

# ============ 多租户行级安全 RLS（P0-4，DB 层兜底）============
# ⚠ 2026-09-28 FIX-A 之后这一项的口径变了，别再按"关了就等于 DB 层没在场"理解：
#   策略与 ENABLE/FORCE 由迁移 002/030/031 直接落库，是**库内持久状态**，与本开关无关，
#   030/031 的 down 脚本也刻意写成 no-op（退回"挂着但不通电"是更坏的状态）。
# false=应用启动时不按清单重建策略（`/status` 的 rls_effective 如实报 disabled）
# true=启动跑 db.EnableRLS()：先 ENABLE 再 FORCE 并回查 pg_class 才报"已启用 N 张"
# 日常隔离保证仍是应用层 db.T/db.RQ/db.PQ + 写入盖章；这一层是第二道闸，且
# 连接账号若是 SUPERUSER/BYPASSRLS 会无条件旁路（上线按 DEPLOY_CHECKLIST §五「通电四查」核验）。
# 开启前建议先跑 ./tools/smoke.sh（§四十七 14 断言专测通电与策略双腿）。
RLS_ENABLED=false

# P2-4(2026-09-19 批三)：/status/detail 全量体检清单访问令牌（未配置=端点恒403）
# ⚠ 下面这个值是**出厂默认**，不是可用凭据：原样带着它上线等于体检清单零守卫
# （`/status/detail` 里的 readiness 会把它报成 credential_placeholders=HEALTH_TOKEN:template_default）。
# 换掉它：openssl rand -hex 16
HEALTH_TOKEN=local-dev-health-2026

# ============ 部署面：模式与网络声明（FIX-N 2026-09-28 补文档）============
# 这几项过去只存在于真 .env 里、模板从没有过，于是「.env 丢了 → 照模板重建」会
# 静默丢掉它们（服务照常起、照常 200，判据却按另一套口径走）。补进模板是防第二次事故。
#
# APP_ENV：与 GIN_MODE 组成启动互断言（APP_ENV=prod 且 GIN_MODE!=release 直接拒启）。
# 留空=非 prod 声明，本机开发可留空；生产必须 prod。
APP_ENV=
# ALLOW_MOCK_PAY：模拟到账端点的显式放行开关。留空/false 是正确的——
# 非显式 debug 模式下开 true 等于 0 元白嫖洞（readiness 的 allow_mock_pay 判 crit）。
ALLOW_MOCK_PAY=false
# TRUSTED_PROXIES：反向代理可信 IP/CIDR 逗号列表。**未配置=不信任任何 XFF**（直连安全），
# 但经 Nginx/云网关部署时漏配，防爆破/注册限流会按代理 IP 聚合（一个代理打全站=集体锁定）。
# 经反代部署必填，例：10.0.0.0/8,172.16.0.1
TRUSTED_PROXIES=
# METRICS_TOKEN：/metrics 的 Bearer 令牌。留空时 /metrics 只允许 loopback 访问
# （本机抓数可用，远端 Prometheus 拉不到）；要远端抓取必须设值，别为了省事改成放开来源。
METRICS_TOKEN=
# APP_REPLICAS：本应用副本数声明（多副本必须同时 REDIS_ENABLED=true，
# 否则合并队列裁决/触达/催缴 sweep 每个实例各跑一遍=双答双封双发信）。
APP_REPLICAS=1

# ============ 告警群机器人：不在这里配（FIX-N 澄清）============
# wecom_webhook_url 是 **system_configs 的平台级键（tenant_id=0）**，由后台/超管配置面写入，
# 代码不读任何 WECOM_WEBHOOK_URL 环境变量。写在 .env 里的后果是"以为配了、其实一条没发"
# （tools/deploy_preflight.sh §2b 会对这种写了没人读的键点名）。
